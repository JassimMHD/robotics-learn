# Copy to .env (ignored by git) only if you need to override defaults.

# Path to the runtime YAML config. Default: config/app.local.yaml if it exists,
# otherwise config/app.example.yaml.
SALTSORT_CONFIG=config/app.local.yaml

# Location of the MuJoCo Menagerie checkout. Default: vendor/mujoco_menagerie
SALTSORT_MENAGERIE_DIR=vendor/mujoco_menagerie
